# Copy to .env.local for local dev. On Vercel, set DATABASE_URL in the project env vars.
# Build-time placeholder so `prisma generate` validates the schema without a real DB.
DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"
# Real production Postgres URL (Neon, Supabase, etc.) — set on Vercel.
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
